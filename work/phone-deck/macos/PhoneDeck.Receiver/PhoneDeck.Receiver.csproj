<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PhoneDeck.Receiver</AssemblyName>
    <RootNamespace>PhoneDeck.MacReceiver</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PhoneDeck.Receiver.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../windows/PhoneDeck.Server/ClientCredentials.cs" Link="PhoneWeb/ClientCredentials.cs" />
    <Compile Include="../../windows/PhoneDeck.Server/PairingWindow.cs" Link="PhoneWeb/PairingWindow.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../shared/Audio/PcmLatency.cs" Link="Shared/PcmLatency.cs" />
    <Compile Include="../../windows/PhoneDeck.Server/PhoneStopReceipts.cs" Link="Shared/PhoneStopReceipts.cs" />
  </ItemGroup>
  <Import Project="../../shared/PhoneWeb/PhoneWeb.props" />
</Project>
