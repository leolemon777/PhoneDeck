<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PhoneDeck.Receiver</AssemblyName>
    <RootNamespace>PhoneDeck.MacReceiver</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!--
    原生精简版：dotnet publish -p:PublishAot=true。只做信号接收，不编入 iPhone 浏览器网关
    （PhoneWeb）；JSON 走编译期元数据。普通 dotnet build / 测试仍包含网关。
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <StripSymbols>true</StripSymbols>
    <DefineConstants>$(DefineConstants);PHONEDECK_LITE</DefineConstants>
    <!-- 原生编译多出 ILCompiler 包，单独锁定，保证普通构建与精简版都能在锁定模式下还原。 -->
    <NuGetLockFilePath>packages.aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' != 'true'">
    <DefineConstants>$(DefineConstants);PHONEDECK_PHONE_WEB</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PhoneDeck.Receiver.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!-- Web SDK 默认把项目里的 .json 当内容复制到输出；锁文件只给还原用。 -->
    <Content Remove="packages.aot.lock.json" />
  </ItemGroup>
  <Import Project="../../shared/Receiver/Receiver.Core.props" />
  <Import Project="../../shared/PhoneWeb/PhoneWeb.props" Condition="'$(PublishAot)' != 'true'" />
</Project>
