<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="FontFamilyHeading">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyBody">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Code, Consolas</FontFamily>

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushGraphite}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
    <Style x:Key="TextPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyHeading}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TextSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyHeading}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TextCardTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushSlate}" />
    </Style>
    <Style x:Key="TextMuted" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource BrushSlate}" />
    </Style>
    <Style x:Key="TextFine" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource BrushMist}" />
    </Style>
</ResourceDictionary>
