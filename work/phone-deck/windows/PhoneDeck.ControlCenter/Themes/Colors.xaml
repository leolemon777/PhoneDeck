<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aether: Apple-style frosted glass, adapted for PhoneDeck. -->
    <Color x:Key="ColorPearl">#EEF1F6</Color>
    <Color x:Key="ColorGlass">#FFFFFF</Color>
    <Color x:Key="ColorGlassStrong">#F2FFFFFF</Color>
    <Color x:Key="ColorGraphite">#1D1D1F</Color>
    <Color x:Key="ColorSlate">#54545A</Color>
    <Color x:Key="ColorMist">#86868B</Color>
    <Color x:Key="ColorSystemBlue">#0A84FF</Color>
    <Color x:Key="ColorSystemBlueHover">#0071E3</Color>
    <Color x:Key="ColorSuccess">#2DA44E</Color>
    <Color x:Key="ColorWarning">#BF7E00</Color>
    <Color x:Key="ColorDanger">#D22A2F</Color>
    <Color x:Key="ColorHairline">#1A0F172A</Color>
    <Color x:Key="ColorHairlineSubtle">#0D0F172A</Color>

    <SolidColorBrush x:Key="BrushPearl" Color="{StaticResource ColorPearl}" />
    <SolidColorBrush x:Key="BrushGlass" Color="{StaticResource ColorGlass}" />
    <SolidColorBrush x:Key="BrushGlassStrong" Color="{StaticResource ColorGlassStrong}" />
    <SolidColorBrush x:Key="BrushGraphite" Color="{StaticResource ColorGraphite}" />
    <SolidColorBrush x:Key="BrushSlate" Color="{StaticResource ColorSlate}" />
    <SolidColorBrush x:Key="BrushMist" Color="{StaticResource ColorMist}" />
    <SolidColorBrush x:Key="BrushSystemBlue" Color="{StaticResource ColorSystemBlue}" />
    <SolidColorBrush x:Key="BrushSystemBlueHover" Color="{StaticResource ColorSystemBlueHover}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushHairline" Color="{StaticResource ColorHairline}" />
    <SolidColorBrush x:Key="BrushHairlineSubtle" Color="{StaticResource ColorHairlineSubtle}" />

    <RadialGradientBrush x:Key="BrushAuroraGlow" Center="0.5,0.22" GradientOrigin="0.5,0.22" RadiusX="0.78" RadiusY="0.78">
        <GradientStop Color="#62C9D6FF" Offset="0" />
        <GradientStop Color="#38E3D3FF" Offset="0.46" />
        <GradientStop Color="#00EEF1F6" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
