<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PhoneDeck.Desktop</AssemblyName>
    <Version>2.0.0-alpha.1</Version>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Makaretu.Dns" Version="2.0.1" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../windows/PhoneDeck.Server/ClientCredentials.cs" Link="Trust/ClientCredentials.cs" />
    <Compile Include="../../windows/PhoneDeck.Server/PairingWindow.cs" Link="Trust/PairingWindow.cs" />
    <Compile Include="../../windows/PhoneDeck.Server/LoopbackOriginGuard.cs" Link="Trust/LoopbackOriginGuard.cs" />
    <Compile Include="../../windows/PhoneDeck.Server/MdnsAdvertiser.cs" Link="Discovery/MdnsAdvertiser.cs" />
    <Compile Include="../../windows/PhoneDeck.Server/LanDiscoveryResponder.cs" Link="Discovery/LanDiscoveryResponder.cs" />
    <EmbeddedResource Include="Ui.html" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>PhoneDeck.Desktop.Tests</_Parameter1></AssemblyAttribute>
  </ItemGroup>
</Project>
