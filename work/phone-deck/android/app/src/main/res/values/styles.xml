<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F0F2F5</item>
        <item name="android:navigationBarColor">#F0F2F5</item>
        <item name="android:colorAccent">#2E5BD7</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A9C7FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#121316</item>
        <item name="android:navigationBarColor">#121316</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
