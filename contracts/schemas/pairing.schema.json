{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://phonedeck.dev/contracts/schemas/pairing.schema.json",
  "title": "发现与配对契约（§16.2 第 1 行）",
  "description": "三份文档：UDP 发现应答【当前形态，LanDiscoveryResponder.cs:7-40：监听 8767、魔术串 PHONEDECK-DISCOVER、应答不含令牌/证书指纹】；USB 配对响应【当前形态，Program.cs:381-401：仅 USB 回环请求可达，否则 404】；扫码配对二维码载荷【目标设计，NET-02：QR 绑定电脑身份/证书与一次性高熵材料，短时窗口、限速、用后失效、电脑本地确认】。数值参数（有效期 120 秒、每窗口 5 次失败为规格候选值，材料长度/二维码大小为 D02 冻结候选）见 contracts/pairing-and-identity.json。",
  "oneOf": [
    { "$ref": "#/definitions/discoveryAdvertisement" },
    { "$ref": "#/definitions/usbPairResponse" },
    { "$ref": "#/definitions/qrPairingPayload" }
  ],
  "definitions": {
    "certificateSha256Lower": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "证书 SHA256 指纹，小写十六进制（LanIdentity.cs:16-17 Convert.ToHexString(...).ToLowerInvariant()）。绑定身份：指纹变化必须拒绝，不得静默接受新证书（规格 §7 NET-04）。"
    },
    "discoveryAdvertisement": {
      "type": "object",
      "description": "UDP 8767 发现应答【当前】。必须只含身份/端口/能力，绝不含配对令牌或证书指纹；未经认证的发现结果不得触发输入或采音（NET-01）。additionalProperties=false 使“发现应答携带令牌”成为可拒绝的形态违例。",
      "properties": {
        "ok": { "const": true },
        "service": { "const": "phonedeck" },
        "protocolVersion": { "$ref": "definitions.schema.json#/definitions/protocolVersionV2" },
        "computerId": { "$ref": "definitions.schema.json#/definitions/computerId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "definitions.schema.json#/definitions/capabilityName" },
          "uniqueItems": true
        }
      },
      "required": ["ok", "service", "protocolVersion", "computerId", "displayName", "port", "capabilities"],
      "additionalProperties": false
    },
    "usbPairResponse": {
      "type": "object",
      "description": "POST /api/lan/pair 响应【当前形态，Program.cs:389-400】。仅当请求来自 USB 回环配对端口时返回，否则 404（Program.cs:383-388，error-codes.json supplementaryStatuses）。accessToken 为共享 LAN 令牌（现状）→ 逐手机凭据迁移见 contracts/pairing-and-identity.json.migration。",
      "properties": {
        "ok": { "const": true },
        "protocolVersion": { "$ref": "definitions.schema.json#/definitions/protocolVersionV2" },
        "computerId": { "$ref": "definitions.schema.json#/definitions/computerId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
        "addresses": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 }, "uniqueItems": true },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "certificateSha256": { "$ref": "#/definitions/certificateSha256Lower" },
        "accessToken": { "$ref": "definitions.schema.json#/definitions/placeholderToken" }
      },
      "required": ["ok", "protocolVersion", "computerId", "displayName", "platform", "addresses", "port", "certificateSha256", "accessToken"],
      "additionalProperties": false
    },
    "qrPairingPayload": {
      "type": "object",
      "description": "二维码配对载荷【目标设计，NET-02】。绑定 computerId+证书指纹+一次性高熵材料；有效期/失败次数为规格候选值（§7：120 秒、每窗口 5 次失败后需重新本机开启）；材料长度/二维码大小候选值见 pairing-and-identity.json（D02 冻结）。手工替代方案（相机拒绝/无法扫码）同文件 manualFallback。",
      "properties": {
        "version": { "const": 1 },
        "computerId": { "$ref": "definitions.schema.json#/definitions/computerId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "httpsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "certificateSha256": { "$ref": "#/definitions/certificateSha256Lower" },
        "pairingId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "配对尝试标识（GUID）：单次使用，用于限速与撤销记录（§16.2 身份行 pairingId）。"
        },
        "oneTimeMaterial": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512,
          "pattern": "^PLACEHOLDER",
          "description": "一次性高熵材料【候选 minLength=32，D02 冻结】。用后失效、不写日志、不进入布局导出（§7 NET-02、SEC-05）。样本必须以 PLACEHOLDER 开头。"
        },
        "validSeconds": { "const": 120 },
        "maxFailuresPerWindow": { "const": 5 }
      },
      "required": ["version", "computerId", "httpsPort", "certificateSha256", "pairingId", "oneTimeMaterial", "validSeconds", "maxFailuresPerWindow"],
      "additionalProperties": false
    }
  }
}
