{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://phonedeck.dev/contracts/schemas/response.error.schema.json",
  "title": "HTTP 4xx/5xx 错误响应（错误域）",
  "description": "错误响应骨架 {ok:false, error, code?}（当前源码 Program.cs:84-88、434-435、562-564、636-641 等仅输出 ok/error）。code 为契约目标字段：稳定产品错误码，与 error-codes.json 一一对应（规格 §16.2 错误与诊断“稳定错误码、HTTP 映射”）。tools/validate.py 会校验本枚举与 error-codes.json 完全一致。",
  "type": "object",
  "properties": {
    "ok": { "const": false },
    "code": { "$ref": "#/definitions/errorCode" },
    "error": { "$ref": "definitions.schema.json#/definitions/errorBrief" }
  },
  "required": ["ok", "error"],
  "additionalProperties": false,
  "definitions": {
    "errorCode": {
      "type": "string",
      "pattern": "^PD-ERR-[0-9]{3}-[0-9]{2}$",
      "enum": [
        "PD-ERR-400-01",
        "PD-ERR-400-02",
        "PD-ERR-400-03",
        "PD-ERR-401-01",
        "PD-ERR-403-01",
        "PD-ERR-409-01",
        "PD-ERR-409-02",
        "PD-ERR-409-03",
        "PD-ERR-409-04",
        "PD-ERR-503-01",
        "PD-ERR-504-01"
      ],
      "description": "注册错误码全集；与 contracts/error-codes.json 的 categories[].code 完全一致。"
    }
  }
}
